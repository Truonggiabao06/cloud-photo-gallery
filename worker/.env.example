# Must match the GCP project and bucket used by Member 2 Backend.
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-existing-private-gcs-bucket

# Must match PUBSUB_TOPIC in Member 2 cloud-photo-backend/.env.
PUBSUB_TOPIC=photo-processing

# Pull Subscription attached to that Topic (not the Topic name itself).
# Use the subscription ID (not the topic name), e.g. photo-processing-worker.
PUBSUB_SUBSCRIPTION=photo-processing-worker

# Member 2 backend URL. Plain HTTP is permitted only for localhost development.
BACKEND_API_BASE_URL=http://localhost:3000

# Must exactly match WORKER_SHARED_SECRET in cloud-photo-backend/.env.
# Use a random secret with at least 32 characters. Never commit the real value.
WORKER_SHARED_SECRET=replace-this-with-the-same-random-secret-of-at-least-32-chars

API_TIMEOUT_SECONDS=15
MAX_MESSAGES=1
MAX_ORIGINAL_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
SHUTDOWN_GRACE_SECONDS=30

# Prefer Application Default Credentials. For local development only, set this
# in the shell to a service-account JSON stored OUTSIDE this repository:
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/gcp-service-account.json

# Cloud Run uses BACKEND_BASE_URL and injects PORT automatically.
# For HTTP push, PUBSUB_TOPIC and PUBSUB_SUBSCRIPTION are not required.
PUBSUB_PUSH_PATH=/pubsub/push

# Render/Supabase mode (Docker selects render_app when WORKER_MODE=outbox).
# WORKER_MODE=outbox
# DATABASE_URL=
# S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=PROJECT_REGION
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=cloud-photos
# BACKEND_BASE_URL=https://YOUR-BACKEND.onrender.com
# OUTBOX_POLL_SECONDS=20
# Reuse the same WORKER_SHARED_SECRET on both services.
