environment          = "prod"
project_name         = "photo07-gia"
repo_url             = "https://github.com/Truonggiabao06/cloud-photo-gallery"
deploy_branch        = "main"
region               = "singapore"
supabase_s3_endpoint = "https://exampleproject.storage.supabase.co/storage/v1/s3"
supabase_s3_region   = "ap-southeast-1"
supabase_bucket      = "photos"
shared_env_group_id  = "evg-replaceme"

