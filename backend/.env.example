PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cloud_gallery

# Microsoft Entra ID: values from the BACKEND API app registration
ENTRA_TENANT_ID=YOUR_DIRECTORY_TENANT_ID
ENTRA_API_CLIENT_ID=YOUR_BACKEND_API_APPLICATION_CLIENT_ID
# For v2 access tokens the expected audience is normally the API app's client ID.
ENTRA_AUDIENCE=YOUR_BACKEND_API_APPLICATION_CLIENT_ID

# Google Cloud
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCS_BUCKET_NAME=YOUR_UNIQUE_BUCKET_NAME
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/gcp-service-account.json

# Pub/Sub topic created in the same GCP project
PUBSUB_TOPIC=photo-processing

# Shared secret for the trusted Worker to update photo status.
# Generate a long random value; never expose it to frontend.
WORKER_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
